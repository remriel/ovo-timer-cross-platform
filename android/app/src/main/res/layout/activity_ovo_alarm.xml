<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ovo_alarm_deep"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.12"
        android:text="TIME UP"
        android:textColor="@color/ovo_alarm_yellow"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="OVO ALARM"
        android:textColor="@color/ovo_alarm_cream"
        android:textSize="42sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="RINGING UNTIL YOU STOP IT"
        android:textColor="@color/ovo_alarm_cream"
        android:textSize="16sp" />

    <Button
        android:id="@+id/stop_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@drawable/ovo_alarm_stop_button"
        android:fontFamily="sans-serif-black"
        android:text="STOP ALARM"
        android:textAllCaps="true"
        android:textColor="@color/ovo_alarm_ink"
        android:textSize="24sp" />

</LinearLayout>

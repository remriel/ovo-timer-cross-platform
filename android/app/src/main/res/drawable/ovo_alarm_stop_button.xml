<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D62920" />
            <stroke android:width="4dp" android:color="@color/ovo_alarm_ink" />
            <padding android:left="20dp" android:top="16dp" android:right="20dp" android:bottom="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ovo_alarm_red" />
            <stroke android:width="4dp" android:color="@color/ovo_alarm_ink" />
            <padding android:left="20dp" android:top="16dp" android:right="20dp" android:bottom="16dp" />
        </shape>
    </item>
</selector>
